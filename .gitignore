# Track only explicitly reviewed configuration directories and root files.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/ghostty/
!/nvim/
!/tmux/
!/scripts/
!/zsh/

# Local configuration documentation.
/doc/

# Private or machine-specific files, even inside allowed directories.
*.local
*.local.*
auth*.json
credentials*
.env
.env.*
*.pem
*.key
.DS_Store
*.swp
*.swo
*.swn

# Only these shell configuration files are shareable.
/zsh/*
!/zsh/.zshrc
!/zsh/.zprofile
